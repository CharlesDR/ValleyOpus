<Project Sdk="Microsoft.NET.Sdk">
  <!-- The game-free engine (doc 09 §2): references nothing from the game, SMAPI or Harmony, so CI can build and test it. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>ValleyOpus.Engine</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ValleyOpus.Tests" />
  </ItemGroup>
</Project>
