<Project>
  <PropertyGroup>
    <!-- C# 10 keeps the engine and the mod buildable with the .NET 6 SDK on a modder's PC; tests and tools use the newest. -->
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- SMAPI 4 runs on .NET 6; building it with a newer SDK is fine. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Version>0.1.0-alpha.1</Version>
    <Authors>CharlesDR</Authors>
  </PropertyGroup>
</Project>
